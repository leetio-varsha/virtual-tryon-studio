# Replicate — IDM-VTON try-on, background removal, FLUX Fill inpainting, Real-ESRGAN upscale
REPLICATE_API_TOKEN=your_replicate_api_token_here

# fal.ai — FASHN, Leffa, FLUX.2 Pro Edit, Grok Imagine, Gemini 3 Pro, GPT Image 1.5, face swap
FAL_KEY=your_fal_ai_key_here

# Shared password for the login gate (middleware.ts).
# Leave unset to disable the gate (a warning is logged and the app is open to anyone).
APP_PASSWORD=your_password_here
